rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file enforces the data structure for the
// Clinical Preceptorship Nursing Exam Simulator (v2).
//
// Collection: users
// Document ID: {userId} (Must match the authenticated user's UID: request.auth.uid)
// Fields:
//   - schemaVersion: int (optional, if present must equal 2) - Client state schema version
//   - email: string (optional, max 320 chars) - User's Google Sign-In email address (PII)
//   - displayName: string (optional, max 200 chars) - User's Google Sign-In display name (PII)
//   - mistakes: list (required, max 2000 items) - List of question IDs currently in the mistakes bank
//   - mistakeTimestamps: map (optional, max 2000 keys) - Per-question monotonic timestamps and tombstones for SYNC-02 conflict resolution
//   - userStats: map (required, allowed keys: ['totalAnswered', 'totalCorrect', 'examsCompleted', 'categoryStats', 'lastResetAt']) - Cumulative performance metrics
//       - totalAnswered: number (required, >= 0)
//       - totalCorrect: number (required, >= 0)
//       - examsCompleted: number (required, >= 0)
//       - categoryStats: map (required, max 50 keys)
//       - lastResetAt: number (optional, >= 0)
//   - savedExams: list (required, max 3 items) - Reserved exam slots in the Quarantine Zone (SAVED-01..SAVED-05)
//   - releasedSavedExams: map (optional, max 200 keys) - Cross-device saved exam release tombstones
//   - updatedAt: string | int | timestamp (required, if string max 64 chars, if int >= 0) - Last cloud sync timestamp
//
// Collection: question_reports
// Document ID: {reportId}
// Fields:
//   - schemaVersion: int (required, == 2)
//   - questionId: string (required, 1..64 chars)
//   - questionText: string (required, <= 250 chars)
//   - source: string (optional, <= 200 chars)
//   - category: string (optional, <= 200 chars)
//   - correctIndex: int (optional, 0..3)
//   - issueType: string (required, enum: KEY_ERROR | EXPLANATION_ERROR | TYPO_TEXT | OUTDATED | OTHER)
//   - comment: string (required, 3..1000 chars)
//   - reporterUid: string (required, == request.auth.uid on create)
//   - reporterEmail: string (optional, <= 320 chars)
//   - reporterName: string (optional, <= 200 chars)
//   - status: string (required, == 'OPEN' on create; enum: OPEN | RESOLVED | DISMISSED on admin update)
//   - adminNote: string (optional on admin update, <= 500 chars)
//   - createdAt: string | int | timestamp (required)
//   - updatedAt: string | int | timestamp (required)
//   - resolvedAt: null | string | int | timestamp (optional on admin update)
//
// Collection: allowed_users
// Document ID: {email} (Normalized lowercase email address matching Firebase Auth token email)
// Fields:
//   - schemaVersion: int (required, == 2)
//   - email: string (required, 3..320 chars, == document ID {email})
//   - active: bool (required; only true grants catalog/sync access)
//   - status: string (required, enum: APPROVED | PENDING | REVOKED)
//   - note: string (optional, <= 300 chars)
//   - displayName: string (optional, <= 200 chars)
//   - uid: string (optional, <= 128 chars; immutable/owned on self-request)
//   - addedBy: string (optional, <= 320 chars)
//   - addedAt: string | int | timestamp (required, immutable on self-update)
//   - updatedAt: string | int | timestamp (required)
//
// Collection: app_config
// Document ID: catalog_key
// Fields:
//   - schemaVersion: int (required, == 2)
//   - keyBase64: string (required, 32..128 chars) - AES-256-GCM symmetric key for encrypted question catalog
//   - updatedAt: string | int | timestamp (required)
//   - updatedBy: string (optional, <= 320 chars)
//
// Collection: app_config
// Document ID: contact
// Fields:
//   - schemaVersion: int (required, == 2)
//   - telegramUrl: string (required, <= 300 chars) - Admin contact link displayed on access-pending gate
//   - updatedAt: string | int | timestamp (required)
//   - updatedBy: string (optional, <= 320 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated Firebase Auth user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is a verified site administrator
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == 'benjaminrotlevy@gmail.com' ||
          request.auth.token.email == 'benjamin@rotlevy.com'
        );
    }

    // Check if the authenticated, email-verified user is actively allowlisted in /allowed_users/{email}
    function isApprovedUser() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)).data.active == true;
    }

    // Check if the authenticated user is either an Admin or an actively approved user
    function isAuthorizedUser() {
      return isAdmin() || isApprovedUser();
    }

    // Check if the authenticated user owns the document at /users/{userId}
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID field (if present) matches the authenticated user on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure UID field (if present) is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate that all required top-level fields exist on the document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains ONLY the whitelisted top-level fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that a list field is a valid list and within maximum length bounds
    function isValidList(listVal, maxSize) {
      return listVal is list && listVal.size() <= maxSize;
    }

    // Validate an optional string field (if present, must be a string within [minLen, maxLen])
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string &&
         data[field].size() >= minLen &&
         data[field].size() <= maxLen);
    }

    // Validate optional schemaVersion (if present, must be integer 2)
    function isValidSchemaVersion(data) {
      return !('schemaVersion' in data) ||
        (data.schemaVersion is int && data.schemaVersion == 2);
    }

    // Validate optional mistakeTimestamps map (SYNC-02 tombstone metadata)
    function isValidMistakeTimestamps(data) {
      return !('mistakeTimestamps' in data) ||
        (data.mistakeTimestamps is map && data.mistakeTimestamps.size() <= 2000);
    }

    // Validate optional releasedSavedExams map (cross-device saved exam release tombstones)
    function isValidReleasedSavedExams(data) {
      return !('releasedSavedExams' in data) ||
        (data.releasedSavedExams is map && data.releasedSavedExams.size() <= 200);
    }

    // Validate the nested userStats map structure, allowed keys, and non-negative counters
    function isValidUserStats(stats) {
      return stats is map &&
        stats.keys().hasOnly([
          'totalAnswered',
          'totalCorrect',
          'examsCompleted',
          'categoryStats',
          'lastResetAt'
        ]) &&
        stats.keys().hasAll([
          'totalAnswered',
          'totalCorrect',
          'examsCompleted',
          'categoryStats'
        ]) &&
        (stats.totalAnswered is int || stats.totalAnswered is float) &&
        stats.totalAnswered >= 0 &&
        stats.totalAnswered <= 10000000 &&
        (stats.totalCorrect is int || stats.totalCorrect is float) &&
        stats.totalCorrect >= 0 &&
        stats.totalCorrect <= 10000000 &&
        (stats.examsCompleted is int || stats.examsCompleted is float) &&
        stats.examsCompleted >= 0 &&
        stats.examsCompleted <= 1000000 &&
        stats.categoryStats is map &&
        stats.categoryStats.size() <= 50 &&
        (!('lastResetAt' in stats) ||
          ((stats.lastResetAt is int || stats.lastResetAt is float) &&
           stats.lastResetAt >= 0));
    }

    // Validate updatedAt field (supports ISO-8601 string, epoch ms int, or Firestore timestamp)
    function isValidUpdatedAt(val) {
      return (val is string && val.size() >= 1 && val.size() <= 64) ||
        (val is int && val >= 0) ||
        (val is timestamp);
    }

    // ===============================================================
    // Domain Validators (Applied on BOTH create and update)
    // ===============================================================

    function isValidUserDocument(data) {
      return hasOnlyAllowedFields([
          'schemaVersion',
          'email',
          'displayName',
          'mistakes',
          'mistakeTimestamps',
          'userStats',
          'savedExams',
          'releasedSavedExams',
          'updatedAt'
        ]) &&
        hasRequiredFields([
          'mistakes',
          'userStats',
          'savedExams',
          'updatedAt'
        ]) &&
        isValidSchemaVersion(data) &&
        isValidOptionalString(data, 'email', 0, 320) &&
        isValidOptionalString(data, 'displayName', 0, 200) &&
        isValidList(data.mistakes, 2000) &&
        isValidMistakeTimestamps(data) &&
        isValidUserStats(data.userStats) &&
        isValidList(data.savedExams, 3) &&
        isValidReleasedSavedExams(data) &&
        isValidUpdatedAt(data.updatedAt);
    }

    function isValidIssueType(val) {
      return val is string && (
        val == 'KEY_ERROR' ||
        val == 'EXPLANATION_ERROR' ||
        val == 'TYPO_TEXT' ||
        val == 'OUTDATED' ||
        val == 'OTHER'
      );
    }

    function isValidReportStatus(val) {
      return val is string && (
        val == 'OPEN' ||
        val == 'RESOLVED' ||
        val == 'DISMISSED'
      );
    }

    function isValidQuestionReport(data) {
      return hasOnlyAllowedFields([
          'schemaVersion',
          'questionId',
          'questionText',
          'source',
          'category',
          'correctIndex',
          'issueType',
          'comment',
          'reporterUid',
          'reporterEmail',
          'reporterName',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        hasRequiredFields([
          'schemaVersion',
          'questionId',
          'questionText',
          'issueType',
          'comment',
          'reporterUid',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.schemaVersion is int &&
        data.schemaVersion == 2 &&
        data.questionId is string &&
        data.questionId.size() >= 1 &&
        data.questionId.size() <= 64 &&
        data.questionText is string &&
        data.questionText.size() <= 250 &&
        isValidOptionalString(data, 'source', 0, 200) &&
        isValidOptionalString(data, 'category', 0, 200) &&
        (!('correctIndex' in data) ||
          (data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex <= 3)) &&
        isValidIssueType(data.issueType) &&
        data.comment is string &&
        data.comment.size() >= 3 &&
        data.comment.size() <= 1000 &&
        data.reporterUid is string &&
        data.reporterUid == request.auth.uid &&
        isValidOptionalString(data, 'reporterEmail', 0, 320) &&
        isValidOptionalString(data, 'reporterName', 0, 200) &&
        data.status == 'OPEN' &&
        isValidUpdatedAt(data.createdAt) &&
        isValidUpdatedAt(data.updatedAt);
    }

    function isValidAllowedUserStatus(val) {
      return val is string && (
        val == 'APPROVED' ||
        val == 'PENDING' ||
        val == 'REVOKED'
      );
    }

    function isValidAllowedUserDocument(data, emailId) {
      return hasOnlyAllowedFields([
          'schemaVersion',
          'email',
          'active',
          'status',
          'note',
          'displayName',
          'uid',
          'addedBy',
          'addedAt',
          'updatedAt'
        ]) &&
        hasRequiredFields([
          'schemaVersion',
          'email',
          'active',
          'status',
          'addedAt',
          'updatedAt'
        ]) &&
        data.schemaVersion is int &&
        data.schemaVersion == 2 &&
        data.email is string &&
        data.email == emailId &&
        data.email.size() >= 3 &&
        data.email.size() <= 320 &&
        data.active is bool &&
        isValidAllowedUserStatus(data.status) &&
        isValidOptionalString(data, 'note', 0, 300) &&
        isValidOptionalString(data, 'displayName', 0, 200) &&
        isValidOptionalString(data, 'uid', 0, 128) &&
        isValidOptionalString(data, 'addedBy', 0, 320) &&
        isValidUpdatedAt(data.addedAt) &&
        isValidUpdatedAt(data.updatedAt);
    }

    function isValidSelfPendingAccessRequest(data, emailId) {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email == emailId &&
        !exists(/databases/$(database)/documents/allowed_users/$(emailId)) &&
        uidUnchanged() &&
        isValidAllowedUserDocument(data, emailId) &&
        data.active == false &&
        data.status == 'PENDING';
    }

    function isValidSelfPendingNoteUpdate(data, existingData, emailId) {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email == emailId &&
        existingData.active == false &&
        existingData.status == 'PENDING' &&
        isValidAllowedUserDocument(data, emailId) &&
        data.active == false &&
        data.status == 'PENDING' &&
        data.addedAt == existingData.addedAt &&
        (!('uid' in data) ||
          (data.uid == request.auth.uid &&
           (!('uid' in existingData) || data.uid == existingData.uid)));
    }

    function isValidCatalogKeyDocument(data) {
      return hasOnlyAllowedFields([
          'schemaVersion',
          'keyBase64',
          'updatedAt',
          'updatedBy'
        ]) &&
        hasRequiredFields([
          'schemaVersion',
          'keyBase64',
          'updatedAt'
        ]) &&
        data.schemaVersion is int &&
        data.schemaVersion == 2 &&
        data.keyBase64 is string &&
        data.keyBase64.size() >= 32 &&
        data.keyBase64.size() <= 128 &&
        isValidOptionalString(data, 'updatedBy', 0, 320) &&
        isValidUpdatedAt(data.updatedAt);
    }

    function isValidContactConfigDocument(data) {
      return hasOnlyAllowedFields([
          'schemaVersion',
          'telegramUrl',
          'updatedAt',
          'updatedBy'
        ]) &&
        hasRequiredFields([
          'schemaVersion',
          'telegramUrl',
          'updatedAt'
        ]) &&
        data.schemaVersion is int &&
        data.schemaVersion == 2 &&
        data.telegramUrl is string &&
        data.telegramUrl.size() <= 300 &&
        isValidOptionalString(data, 'updatedBy', 0, 320) &&
        isValidUpdatedAt(data.updatedAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Invite-Only Access Control Allowlist (Admin-managed; verified users may read own entry or request PENDING access)
    match /allowed_users/{email} {
      allow get: if isAdmin() ||
        (isAuthenticated() &&
         request.auth.token.email_verified == true &&
         request.auth.token.email == email);
      allow list, delete: if isAdmin();
      allow create: if (isAdmin() && isValidAllowedUserDocument(request.resource.data, email)) ||
        isValidSelfPendingAccessRequest(request.resource.data, email);
      allow update: if (isAdmin() && isValidAllowedUserDocument(request.resource.data, email)) ||
        isValidSelfPendingNoteUpdate(request.resource.data, resource.data, email);
    }

    // Key-Gated Encrypted Catalog Symmetric Key (Readable ONLY by verified Admins or actively approved users)
    match /app_config/catalog_key {
      allow get: if isAuthorizedUser();
      allow create, update: if isAdmin() && isValidCatalogKeyDocument(request.resource.data);
      allow list, delete: if false;
    }

    // Access-Gate Admin Contact Configuration (Readable by any signed-in user to display Telegram contact info)
    match /app_config/contact {
      allow get: if isAuthenticated();
      allow create, update: if isAdmin() && isValidContactConfigDocument(request.resource.data);
      allow list, delete: if false;
    }

    // User Progress & Quarantine Zone Documents
    // Strictly private to the authenticated, authorized document owner (protects PII such as email/displayName)
    match /users/{userId} {
      allow read: if isOwner(userId) && isAuthorizedUser();
      allow create: if isOwner(userId) && isAuthorizedUser() && uidUnchanged() && isValidUserDocument(request.resource.data);
      allow update: if isOwner(userId) && isAuthorizedUser() && uidNotModified() && isValidUserDocument(request.resource.data);
      // Users reset progress via in-place update (resetCloudData), never by deleting the document
      allow delete: if false;
    }

    // Question Issue Reports (Authorized users submit; ONLY verified Admins read/resolve/delete)
    match /question_reports/{reportId} {
      allow create: if isAuthorizedUser() && isValidQuestionReport(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin() &&
        hasOnlyAllowedFields([
          'schemaVersion',
          'questionId',
          'questionText',
          'source',
          'category',
          'correctIndex',
          'issueType',
          'comment',
          'reporterUid',
          'reporterEmail',
          'reporterName',
          'status',
          'adminNote',
          'createdAt',
          'updatedAt',
          'resolvedAt'
        ]) &&
        isValidReportStatus(request.resource.data.status) &&
        isValidOptionalString(request.resource.data, 'adminNote', 0, 500) &&
        isValidUpdatedAt(request.resource.data.updatedAt) &&
        (!('resolvedAt' in request.resource.data) ||
          request.resource.data.resolvedAt == null ||
          isValidUpdatedAt(request.resource.data.resolvedAt));
    }

    // Default Deny: Explicitly reject reads and writes to all other collections and subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
